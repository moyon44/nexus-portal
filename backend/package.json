{
  "name": "nexus-portal-backend",
  "version": "0.0.1",
  "description": "Backend for Nexus Portal with Postgres persistence and audit logging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "init": "tsx src/init.ts",
    "migrate": "knex migrate:latest --knexfile dist/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile dist/knexfile.js",
    "seed": "knex seed:run --knexfile dist/knexfile.js"
  },
  "keywords": [
    "dashboard",
    "postgres",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/dockerode": "^4.0.1",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
