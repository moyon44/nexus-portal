# Copy to .env next to docker-compose.yml and fill in.

# Postgres password (used by the database and the backend).
DB_PASSWORD=change-me

# Public host names the portal is reached through, comma-separated.
# ALLOWED_HOSTS lets the Vite dev server answer them (".example.com" = every subdomain);
# CORS_ORIGINS lets those pages call the API.
ALLOWED_HOSTS=
CORS_ORIGINS=

# Optional: the legacy Jellyfin statistics routes (the Jellyfin tile widget
# is configured in Admin → Intégrations instead).
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Optional: web search in Ctrl K through SearXNG (enable "json" in its
# settings.yml → search.formats). The backend must be able to reach it.
SEARXNG_URL=http://searxng:8080
