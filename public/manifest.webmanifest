{
  "name": "Nexus Portal",
  "short_name": "Nexus",
  "description": "Portail des services du serveur",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#121212",
  "lang": "fr",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Système", "url": "/#/systeme", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Administration", "url": "/#/admin", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
